{
  "connector": "github-mcp",
  "sources": [
    {
      "source_id": "issues",
      "record_type": "Issue",
      "tools": [
        "github_search_issues"
      ],
      "records_path": "data.items",
      "id_field": "id",
      "title_field": "title",
      "text_field": "body",
      "cursor_field": "updated_at",
      "incremental": false,
      "arguments": {
        "q": "is:issue is:open involves:@me",
        "per_page": 50,
        "max_pages": 1
      },
      "description": "Open GitHub issues involving the authenticated user (first 50)."
    }
  ]
}
